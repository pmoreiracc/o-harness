{"description":"OH hooks provide conversation references for workflow decisions, check agent launch settings, track agent and tool activity, and honor requests to stop OH work.","hooks":{"PostToolUse":[{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/agent-event.py\" claude","statusMessage":"OH: recording agent lifecycle evidence","timeout":15,"type":"command"}],"matcher":"Agent|Task|SubagentHandback"},{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/native-control.py\" claude","statusMessage":"OH: recording completed tool activity","timeout":10,"type":"command"}]}],"PostToolUseFailure":[{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/native-control.py\" claude","statusMessage":"OH: recording failed tool activity","timeout":10,"type":"command"}]}],"PreToolUse":[{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/agent-launch.py\" claude","statusMessage":"OH: checking agent settings before launch","timeout":15,"type":"command"}],"matcher":"Agent"},{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/native-control.py\" claude","statusMessage":"OH: checking whether work may continue before a tool runs","timeout":10,"type":"command"}]}],"SubagentStart":[{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/native-control.py\" claude","statusMessage":"OH: tracking a started agent","timeout":10,"type":"command"}]}],"SubagentStop":[{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/agent-event.py\" claude","statusMessage":"OH: recording finished agents","timeout":15,"type":"command"}],"matcher":"^o-harness:(implementation|analysis|assessment|reviewer)$"}],"UserPromptSubmit":[{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/human-event.py\" claude","statusMessage":"OH: providing the conversation reference for workflow decisions","timeout":15,"type":"command"}]}]}}
