#!/usr/bin/env -S python3 -I
import sys
sys.dont_write_bytecode = True
import os
if os.name == 'nt' and not sys.flags.utf8_mode:
    # Windows defaults to a legacy code page; OH state, documents and transcripts are UTF-8.
    import subprocess
    raise SystemExit(subprocess.run([sys.executable, '-I', '-X', 'utf8', __file__, *sys.argv[1:]]).returncode)
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent / 'runtime'))
from oh.cli import main
main()
