#!/usr/bin/env -S python3 -I
"""Resolve bundled setup or the explicitly installed shared core, never the product cwd."""
import json
import os
from pathlib import Path
import sys
sys.dont_write_bytecode = True
plugin=Path(__file__).resolve().parents[1]
import argparse
parser=argparse.ArgumentParser(add_help=False)
parser.add_argument('--root',default=os.getcwd())
options,remaining=parser.parse_known_args()
command=remaining[0] if remaining else ''
if command=='setup':
    entry=plugin/'core/oh'
else:
    home=Path(os.environ.get('OH_DATA_HOME',Path.home()/'.local/share/o-harness')).expanduser().resolve()
    active=home/'runtime/active.json'
    if not active.is_file() and command=='plugin-hook':
        prompt=json.load(sys.stdin).get('prompt')
        # Bare choices such as "continue" are ordinary prose until OH is set up.
        if isinstance(prompt,str) and prompt.strip()[:1] in ('$','/'):print(json.dumps({'authorized':False,'onboarding':'Run this plugin scripts/oh setup explicitly, register the selected checkout with init, then submit a fresh workflow invocation.'}))
        raise SystemExit(0)
    if not active.is_file():
        raise SystemExit('OH is not set up. Run this plugin command with setup first.')
    revision=json.loads(active.read_text())['revision']
    if Path(revision).name!=revision:raise SystemExit('Invalid installed OH revision')
    if command in ('run','start','deliver','resume','pause','stop','plugin-hook'):
        import hashlib
        key=hashlib.sha256(json.dumps(str(Path(options.root).resolve()),ensure_ascii=False,separators=(',',':')).encode()).hexdigest()
        locator=home/'registry/checkouts'/(key+'.json')
        if locator.is_file():
            checkout=json.loads(locator.read_text())
            active_run=home/'checkout-state'/checkout['checkout']/'oh-active-run.json'
            if active_run.is_file():
                binding=json.loads(active_run.read_text())
                start=home/'projects'/binding['project']/'runs'/binding['run']/'000001.json'
                status='running'
                for record in sorted(start.parent.glob('[0-9]*.json'),reverse=True):
                    value=json.loads(record.read_text())
                    events=value['data'].get('events',[]) if value['kind']=='transition' else [value]
                    found=next((e['data']['status'] for e in reversed(events) if e['kind']=='run.status'),None)
                    if found is not None:status=found;break
                if status not in ('stopped','completed','pr'):
                    revision=json.loads(start.read_text())['data']['harness_version']
                    if Path(revision).name!=revision:raise SystemExit('Invalid retained runtime revision')
    entry=home/'versions'/revision/'oh'
if not entry.is_file():raise SystemExit('Shared OH core is missing. Rebuild/reinstall the plugin, then run setup.')
os.execv(sys.executable,[sys.executable,'-I',str(entry),*sys.argv[1:]])
