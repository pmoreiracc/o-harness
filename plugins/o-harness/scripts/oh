#!/bin/sh
""":"
self=$0
while [ -h "$self" ]; do link=$(readlink "$self"); case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac; done
exec sh "$(dirname "$self")/python.sh" --launcher "$self" "$@"
":"""
"""Resolve bundled setup or the explicitly installed shared core, never the product cwd."""
import json
import os
from pathlib import Path
import sys
sys.dont_write_bytecode = True
def filesystem_path(value):
    # Bootstrap precedes importing OH's platform layer. These paths are I/O only,
    # never saved identities; the active engine will use its own system.Path.
    path=os.path.abspath(os.path.expanduser(str(value)))
    if os.name=='nt' and not path.startswith('\\\\?\\'):
        path='\\\\?\\UNC\\'+path[2:] if path.startswith('\\\\') else '\\\\?\\'+path
    return Path(path)
plugin=filesystem_path(__file__).resolve().parents[1]
# Windows needs UTF-8 mode requested explicitly; POSIX runs OH exactly as before.
python=[sys.executable,'-I',*(['-X','utf8'] if os.name=='nt' else [])]
import argparse
parser=argparse.ArgumentParser(add_help=False)
parser.add_argument('--root',default=os.getcwd())
options,remaining=parser.parse_known_args()
command=remaining[0] if remaining else ''
if command=='setup':
    entry=plugin/'core/oh'
else:
    home=filesystem_path(os.environ.get('OH_DATA_HOME',Path.home()/'.local/share/o-harness')).resolve()
    active=home/'runtime/active.json'
    bundled=plugin/'core/revision.json'
    if bundled.is_file() and command not in ('native-event','native-control'):
        # A plugin install or update carries its core. Activate it on first explicit use when it is
        # newer than the active core, so an older plugin in another host never downgrades OH.
        def number(value):
            try:return tuple(int(part) for part in str(value).split('.'))
            except ValueError:return ()
        package=json.loads(bundled.read_bytes())
        current=json.loads(active.read_bytes()) if active.is_file() else {}
        if '+worktree.' not in package['revision'] and package['revision']!=current.get('revision') and (
                not current or number(package.get('version'))>number(current.get('version'))):
            import subprocess
            done=subprocess.run([*python,str(plugin/'core/oh'),'setup','--if-newer'],stdin=subprocess.DEVNULL,capture_output=True,encoding='utf-8',errors='replace')
            if done.returncode:print('OH: automatic setup failed. '+done.stderr.strip(),file=sys.stderr)
    if not active.is_file():
        if command in ('native-event','native-control'):raise SystemExit(0)
        raise SystemExit('OH is not set up. Run this plugin command with setup first.')
    revision=json.loads(active.read_bytes())['revision']
    if Path(revision).name!=revision:raise SystemExit('Invalid installed OH revision')
    # Current helpers read historical evidence; never route back to the retired executor.
    entry=home/'versions'/revision/'oh'
if not entry.is_file():raise SystemExit('Shared OH core is missing. Rebuild/reinstall the plugin, then run setup.')
if os.name=='nt':
    if command=='native-control':
        import runpy
        sys.argv[0]=str(entry)
        runpy.run_path(str(entry),run_name='__main__')
        raise SystemExit(0)
    # Windows has no exec: os.execv would return control to the caller before OH finishes.
    import subprocess
    raise SystemExit(subprocess.run([*python,str(entry),*sys.argv[1:]]).returncode)
os.execv(sys.executable,[*python,str(entry),*sys.argv[1:]])
