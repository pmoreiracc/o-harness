#!/usr/bin/env -S python3 -I
"""Codex starts this from the plugin's .mcp.json: OH's tools for Codex (see runtime/oh/mcp_server.py). No `oh`
command reaches this server, so a host rule that allows `oh` commands never lets a model start it outside its sandbox."""
import json
import os
from pathlib import Path
import sys
sys.dont_write_bytecode=True
home=Path(os.environ.get('OH_DATA_HOME',Path.home()/'.local/share/o-harness')).expanduser().resolve()
try:revision=json.loads((home/'runtime/active.json').read_bytes())['revision']
except (OSError,ValueError,KeyError):raise SystemExit('OH is not set up. Run this plugin scripts/oh setup first.')
core=home/'versions'/str(revision)
if Path(str(revision)).name!=revision or not (core/'runtime/oh/mcp_server.py').is_file():
    raise SystemExit('Shared OH core is missing. Rebuild/reinstall the plugin, then run setup.')
sys.path.insert(0,str(core/'runtime'))
from oh.mcp_server import serve
# Commands run through this plugin's own launcher, as they would from the shell.
serve(sys.stdin,sys.stdout,Path(__file__).resolve().parent/'oh')
