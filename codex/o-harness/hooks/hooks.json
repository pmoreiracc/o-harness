{"description":"OH hooks provide conversation references for workflow decisions, check agent launch settings, track agent and tool activity, and honor requests to stop OH work.","hooks":{"Interrupt":[{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/native-control.py\" codex","commandWindows":"cmd.exe /d /v:on /s /c \"!PLUGIN_ROOT!\\scripts\\native-control.cmd\" codex","statusMessage":"OH: recording your request to stop work","timeout":5,"type":"command"}]}],"PostToolUse":[{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/native-control.py\" codex","commandWindows":"cmd.exe /d /v:on /s /c \"!PLUGIN_ROOT!\\scripts\\native-control.cmd\" codex","statusMessage":"OH: recording completed tool activity","timeout":10,"type":"command"}]}],"PreToolUse":[{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/agent-launch.py\" codex","commandWindows":"cmd.exe /d /v:on /s /c \"!PLUGIN_ROOT!\\scripts\\agent-hook.cmd\" codex","statusMessage":"OH: checking agent settings before launch","timeout":15,"type":"command"}],"matcher":"Agent"},{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/native-control.py\" codex","commandWindows":"cmd.exe /d /v:on /s /c \"!PLUGIN_ROOT!\\scripts\\native-control.cmd\" codex","statusMessage":"OH: checking whether work may continue before a tool runs","timeout":10,"type":"command"}]}],"SubagentStart":[{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/native-control.py\" codex","commandWindows":"cmd.exe /d /v:on /s /c \"!PLUGIN_ROOT!\\scripts\\native-control.cmd\" codex","statusMessage":"OH: tracking a started agent","timeout":10,"type":"command"}]}],"UserPromptSubmit":[{"hooks":[{"command":"sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts