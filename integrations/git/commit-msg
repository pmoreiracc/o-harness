#!/usr/bin/env bash
# Commit shape on a delivery branch, checked while it is still free to fix.
#
# CI checks the same thing, but four commits later — by which point correcting it means
# an interactive rebase. Here it costs one retry.
#
# Delivery branches constrain commit shape; reviewed non-delivery branches constrain the
# preparation and resolution trailers that make their PR handoff durable.
set -uo pipefail

MSG_FILE="${1:-}"
[ -f "$MSG_FILE" ] || exit 0

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
. "${OH_HOME:-$ROOT}/core/review-workflow.sh" || exit 1

# A PR-only scope disposition must enter history on the first commit after the human choice.
# Otherwise omitting both its trailer and its PR section would erase the only durable record.
REQUIRED_PENDING=$(review_branch_pending_resolution_ids "$ROOT" "$BRANCH") || exit 1
for ID in $REQUIRED_PENDING; do
  [ "$(grep -cFx "Review-Resolution: $ID" "$MSG_FILE")" = 1 ] || {
    echo "REFUSED — this commit must retain a PR-only review resolution." >&2
    echo "Carry: Review-Resolution: $ID" >&2
    exit 1
  }
done

# A reviewed non-delivery commit must carry the preparation for this exact parent and
# staged Git tree. The post-commit seal binds that preparation to the resulting HEAD.
case "$BRANCH" in
  HEAD|main|deliver/*) ;;
  *)
    REQUIRED_PREPARATION=$(review_branch_pending_preparation_id "$ROOT" "$BRANCH") || exit 1
    if grep -q '^Review-Preparation:' "$MSG_FILE" \
       && [ "$(grep -cE '^Review-Preparation: [0-9a-f]{64}$' "$MSG_FILE")" != "$(grep -c '^Review-Preparation:' "$MSG_FILE")" ]; then
      echo "REFUSED — Review-Preparation must carry the exact 64-hex ID printed by review-finish.sh." >&2
      exit 1
    fi
    if [ -n "$REQUIRED_PREPARATION" ] \
       && [ "$(grep -cFx "Review-Preparation: $REQUIRED_PREPARATION" "$MSG_FILE")" != 1 ]; then
      echo "REFUSED — this commit must carry its exact reviewed-tree preparation." >&2
      echo "Carry: Review-Preparation: $REQUIRED_PREPARATION" >&2
      exit 1
    fi
    ;;
esac

# The numbered design grammar is opt-in consumer policy. Legacy fixtures without
# an OH project registration retain their original compatibility behavior.
if [ -f "$ROOT/.oh/project.json" ]; then
  [ "$(jq -r '.design_profile // empty' "$ROOT/.oh/project.json")" = consumer-v1 ] || exit 0
fi
case "$BRANCH" in deliver/*) ;; *) exit 0 ;; esac

SUBJECT=$(grep -v '^#' "$MSG_FILE" | sed '/^[[:space:]]*$/d' | head -1)

case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
  "review: "*) exit 0 ;;
  "task "[0-9]*": "*)
    if ! grep -qE '^Review-Rounds: [0-9]+$' "$MSG_FILE"; then
      echo "" >&2
      echo "REFUSED — a task commit records how many review rounds it took." >&2
      echo "" >&2
      echo "  $SUBJECT" >&2
      echo "" >&2
      echo "complete.sh prints the trailer; put it in the message:" >&2
      echo "" >&2
      echo "  Review-Rounds: <n>" >&2
      echo "" >&2
      echo "It is what makes an unbounded review loop visible in the PR rather than" >&2
      echo "merely discouraged (ADR-0027)." >&2
      exit 1
    fi
    DOC=${BRANCH#deliver/}; DOC=${DOC%%-*}
    TASK=${SUBJECT#task }; TASK=${TASK%%:*}
    DESIGN=""
    for CANDIDATE in "$ROOT/docs/design/$DOC"-*.md; do
      [ -f "$CANDIDATE" ] || continue
      [ -z "$DESIGN" ] || { echo "REFUSED — multiple design docs match $DOC." >&2; exit 1; }
      DESIGN="$CANDIDATE"
    done
    [ -n "$DESIGN" ] || { echo "REFUSED — no design doc matches $DOC." >&2; exit 1; }
    REQUIRED_IDS=$(review_consumption_required_resolution_ids "$ROOT" "complete:$DOC:$TASK" "$DESIGN") || exit 1
    if grep -q '^Review-Resolution:' "$MSG_FILE" \
       && ! grep -Eq '^Review-Resolution: [0-9a-f]{64}$' "$MSG_FILE"; then
      echo "REFUSED — Review-Resolution must carry the exact 64-hex ID printed by complete.sh." >&2
      exit 1
    fi
    for ID in $REQUIRED_IDS; do
      [ "$(grep -cFx "Review-Resolution: $ID" "$MSG_FILE")" = 1 ] || {
        echo "REFUSED — this task consumed a PR-only review resolution." >&2
        echo "Carry the exact trailer printed by complete.sh: Review-Resolution: $ID" >&2
        exit 1
      }
    done
    exit 0 ;;
esac

echo "" >&2
echo "REFUSED — on a delivery branch, every commit is a task or a review round." >&2
echo "" >&2
echo "  $SUBJECT" >&2
echo "" >&2
echo "Expected one of:" >&2
echo "  task <n>: <title>      the task itself, with a Review-Rounds: trailer" >&2
echo "  review: <what changed> a round of fixes from the adversarial review" >&2
echo "" >&2
echo "One task is one commit (ADR-0029). Work that is neither belongs on its own branch." >&2
exit 1
