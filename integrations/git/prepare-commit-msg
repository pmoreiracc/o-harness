#!/usr/bin/env bash
# Preserve review binding trailers across a content-identical commit amend.
set -uo pipefail

MSG_FILE="${1:-}"
SOURCE="${2:-}"
COMMIT="${3:-}"
[ -f "$MSG_FILE" ] || exit 0
case "$SOURCE" in
  commit)
    [ -n "$COMMIT" ] || exit 0
    [ "$COMMIT" = "$(git rev-parse HEAD 2>/dev/null)" ] || exit 0
    ;;
  message)
    COMMIT=$(git rev-parse HEAD 2>/dev/null) || exit 0
    ;;
  *) exit 0 ;;
esac
git rev-parse --verify "$COMMIT^{commit}" >/dev/null 2>&1 || exit 1
# A changed index creates a different committed tree and therefore needs another review.
git diff --cached --quiet "$COMMIT" -- . || exit 0

TRAILERS=$(git show -s --format=%B "$COMMIT" 2>/dev/null \
  | sed -n -e '/^Review-Preparation: [0-9a-f]\{64\}$/p' \
           -e '/^Review-Resolution: [0-9a-f]\{64\}$/p' | awk '!seen[$0]++') || exit 1
[ -n "$TRAILERS" ] || exit 0

while IFS= read -r TRAILER; do
  [ -n "$TRAILER" ] || continue
  if ! grep -qFx "$TRAILER" "$MSG_FILE"; then
    printf '\n%s\n' "$TRAILER" >> "$MSG_FILE" || exit 1
  fi
done <<EOF
$TRAILERS
EOF
