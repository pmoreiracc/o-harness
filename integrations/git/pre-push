#!/usr/bin/env bash
# Runs before anything leaves this machine.
#
# What this is, precisely: branch protection is a paid feature on private repositories,
# so CI can report but cannot block a merge. This closes the *push* path — it makes
# "run the verifiers before opening a PR" a precondition instead of a line in a skill.
#
# What it is NOT: enforcement. `git push --no-verify` skips it entirely, and passing here
# is not the same as passing on a clean checkout — these are shell scripts and BSD and GNU
# tools disagree. CI remains the authority; this is the fast, forgetful-case control.
#
# Enabled by `git config core.hooksPath .githooks`, which the SessionStart hook sets.
set -uo pipefail

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1

# --- do not lend this repository to the suites -----------------------------------------
# A push run from a linked worktree arrives here with GIT_DIR already exported, pointing at
# `<primary>/.git/worktrees/<name>` (an ordinary push from the primary checkout does not —
# git 2.55 passes only GIT_EDITOR, GIT_EXEC_PATH and GIT_PREFIX). Any caller that exported
# the git environment itself does the same. The affected verifier can run suites that create
# fixture repositories in temp directories and run git inside them; with these still set, those
# commands operate on THIS repository instead of the fixture. That is not hypothetical:
# it moved the real HEAD, left `deliver/0942`-style fixture branches behind, wrote a
# fixture identity into `.git/config`, and set `core.bare = true`, which hides the working
# tree from git entirely until someone finds the flag.
#
# ROOT is already resolved above, and cwd is now the top level, so every git call from here
# down finds the same repository by ordinary discovery. Nothing below needs the inherited
# environment, and nothing spawned below should have it.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE GIT_PREFIX

# --- nothing goes straight to the trunk -----------------------------------------------
ZERO="0000000000000000000000000000000000000000"
PUSHED_SHA=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # a deletion
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "" >&2
      echo "REFUSED — nothing is pushed straight to ${remote_ref#refs/heads/}." >&2
      echo "Trunk-based means short-lived branches merged through a PR" >&2
      echo "(operations.md §7). Branch, push that, open a PR." >&2
      exit 1 ;;
  esac
  if [ -z "$PUSHED_SHA" ]; then
    PUSHED_SHA="$local_sha"
  elif [ "$PUSHED_SHA" != "$local_sha" ]; then
    echo "REFUSED — one push may contain only refs at the checked-out HEAD." >&2
    exit 1
  fi
done

[ -n "$PUSHED_SHA" ] || exit 0                 # deletion-only push
HEAD_SHA=$(git rev-parse HEAD) || exit 1
if [ "$PUSHED_SHA" != "$HEAD_SHA" ]; then
  echo "REFUSED — the pushed ref is not the checked-out HEAD." >&2
  echo "Check out that ref and push it again so its exact tree can be verified." >&2
  exit 1
fi

DIRTY=$(git status --porcelain --untracked-files=all) || exit 1
if [ -n "$DIRTY" ]; then
  echo "REFUSED — the checkout has uncommitted changes." >&2
  echo "Commit the reviewed authorized changes first. Preserve unrelated work in its own checkout, then retry so verification covers only HEAD." >&2
  exit 1
fi

# --- fast affected checks; clean-checkout CI remains authoritative --------------------
git fetch -q origin main 2>/dev/null || true      # best effort; offline is fine

BASE=origin/main
echo "pre-push:"
if ! "${OH_HOME:-$ROOT}/core/scripts/verify-change.sh" "$BASE" pre-push; then
  echo "" >&2
  echo "REFUSED — affected local verification failed." >&2
  echo "Fix the reported failure, rerun affected verification, then retry this push. Do not bypass the checks." >&2
  exit 1
fi

exit 0
