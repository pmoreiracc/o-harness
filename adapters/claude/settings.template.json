{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill(claude-api)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/adr-immutability.sh",
            "statusMessage": "Checking ADR immutability",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/doc-frontmatter.sh",
            "statusMessage": "Checking doc frontmatter",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/protect-receipts.sh",
            "statusMessage": "Protecting review receipts",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/protect-local-policy.sh",
            "statusMessage": "Protecting human-owned delivery policy",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/review-dispatch.sh",
            "statusMessage": "Checking and binding invariant review",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/review-detached-context.sh",
            "statusMessage": "Resuming the explicit detached review context",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/round-track.sh",
            "statusMessage": "Tracking a spawned reviewer",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/adr-log-index.sh",
            "statusMessage": "Checking the ADR log index",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/adr-write-detector.sh",
            "statusMessage": "Checking for writes to accepted ADRs",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/main-branch-detector.sh",
            "statusMessage": "Checking the trunk is clean",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/round-grant.sh",
            "statusMessage": "Recording a review-round grant",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/review-choice.sh",
            "statusMessage": "Recording the review outcome choice",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/task-grant.sh",
            "statusMessage": "Recording a task-boundary choice",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "invariant-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/review-receipt.sh",
            "statusMessage": "Retaining the review attempt",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/core/hooks/enable-githooks.sh",
            "statusMessage": "Activating the committed git hooks",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
