{
  "description": "Codex adapters for the canonical development harness under core/.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" edit adr-immutability.sh",
            "statusMessage": "Checking ADR immutability",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" edit doc-frontmatter.sh",
            "statusMessage": "Checking doc frontmatter",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" edit protect-receipts.sh",
            "statusMessage": "Protecting review receipts",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" edit protect-local-policy.sh",
            "statusMessage": "Protecting human-owned delivery policy",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" review-pending-output.sh",
            "statusMessage": "Checking reviewer output retention",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" review-pending-output.sh",
            "statusMessage": "Checking reviewer output retention",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" round-refuse.sh",
            "statusMessage": "Checking the review-round window before startup",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" edit adr-log-index.sh",
            "statusMessage": "Checking the ADR log index",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" adr-write-detector.sh",
            "statusMessage": "Checking for writes to accepted ADRs",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" main-branch-detector.sh",
            "statusMessage": "Checking the trunk is clean",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "invariant-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" review-ready-gate.sh",
            "statusMessage": "Checking delivery review readiness",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" round-refuse.sh",
            "statusMessage": "Checking the review-round window",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" review-start.sh",
            "statusMessage": "Binding the review to this tree",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "invariant-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" review-receipt.sh",
            "statusMessage": "Retaining the review attempt",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" enable-githooks.sh",
            "statusMessage": "Activating the committed git hooks",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/adapters/codex/run.sh\" round-grant.sh",
            "statusMessage": "Recording an exact human workflow choice",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
